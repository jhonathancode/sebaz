# Copie este archivo como .env.local (en su computadora) y configure las mismas
# variables en Vercel → Project → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo en el servidor. Nunca la comparta ni la ponga en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Nombre que se muestra en el sistema (se puede cambiar cuando quiera)
NEXT_PUBLIC_APP_NOMBRE=Sistema MCP
